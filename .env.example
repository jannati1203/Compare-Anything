# Compare Anything - Environment Configuration Template
# Copy this file to .env or set these environment variables in your server environment.
# NEVER commit your real .env file or production secrets to version control.

# ==========================================
# Primary AI Provider: Groq (Required)
# ==========================================
# Obtain your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# AI Model Selection (Default: openai/gpt-oss-20b)
AI__Model=openai/gpt-oss-20b

# AI Provider Selection ("Groq" or "OpenRouter")
AI__Provider=Groq

# Maximum Tokens for AI Completion (Default: 8192)
AI__MaxTokens=8192

# ==========================================
# Fallback AI Provider: OpenRouter (Optional)
# ==========================================
# Obtain your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ==========================================
# Rate Limiting & Abuse Protection
# ==========================================
RateLimit__ComparisonsPerInstallPerDay=10
RateLimit__ComparisonsPerIpPerHour=30
RateLimit__Enabled=true

# ==========================================
# ASP.NET Core Hosting & Environment
# ==========================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://127.0.0.1:7123;http://127.0.0.1:5123
AllowedHosts=*

# ==========================================
# CORS Allowed Origins
# ==========================================
# Comma-separated or JSON array of origins permitted in production
Cors__AllowedOrigins__0=https://compareanything.app
Cors__AllowedOrigins__1=https://app.compareanything.com
