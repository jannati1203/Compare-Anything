{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Groq",
    "Model": "openai/gpt-oss-20b",
    "GroqBaseUrl": "https://api.groq.com/openai/v1",
    "OpenRouterBaseUrl": "https://openrouter.ai/api/v1",
    "TimeoutSeconds": 45,
    "MaxRetries": 2,
    "MaxTokens": 8192
  },
  "RateLimit": {
    "Enabled": true,
    "ComparisonsPerInstallPerDay": 10,
    "ComparisonsPerIpPerHour": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  }
}
