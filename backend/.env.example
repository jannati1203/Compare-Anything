# Compare Anything - Environment Configuration Template
# Copy this file to .env or set these environment variables on your server/terminal.
# NEVER commit your real .env file or secrets to version control.

# ==========================================
# Primary AI Provider: Groq
# ==========================================
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Override AI model (default is openai/gpt-oss-20b)
# Other compatible models: llama-3.3-70b-versatile, llama-3.1-8b-instant
AI__Model=openai/gpt-oss-20b

# AI Provider selection ("Groq" or "OpenRouter")
AI__Provider=Groq

# ==========================================
# Fallback AI Provider: OpenRouter (Optional)
# ==========================================
# Obtain your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ==========================================
# Rate Limiting & Abuse Protection
# ==========================================
RateLimit__ComparisonsPerInstallPerDay=10
RateLimit__ComparisonsPerIpPerHour=30
RateLimit__Enabled=true

# ==========================================
# ASP.NET Core Hosting
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5123
